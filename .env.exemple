# Variables d'environnement de VEILLIA
# Copier ce fichier en .env puis remplir les valeurs.
# Ne jamais versionner le fichier .env.

DJANGO_SECRET_KEY=changez-cette-cle
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Abidjan

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SITE_URL=http://localhost:8000

# Base de donnees
# Renseigner POSTGRES_DB pour basculer sur PostgreSQL.
# Si la variable est vide le projet utilise SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Service de resume par IA - Gemini (primaire, faible consommation de tokens)
GEMINI_API_KEY=votre-cle-gemini-ici
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_PAUSE=6
LANGUE_RESUME=fr

# OpenRouter en fallback quand les credits Gemini sont insuffisants
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=votre-cle-openrouter-ici
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001

# Moteur d'embedding pour les recommandations (calcul local, sans API externe)
EMBEDDING_MODELE=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_LOT=8
EMBEDDING_MAX_CARACTERES=1800
EMBEDDING_SEUIL_BAS=0.35
EMBEDDING_SEUIL_HAUT=0.70
# Facultatif : accelere le telechargement du modele depuis Hugging Face
HF_TOKEN=

# Connexion avec Github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback/

# Connexion avec Linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/oauth/linkedin/callback/

# Jeton partage avec l'agent n8n
N8N_WEBHOOK_TOKEN=changez-ce-token