{
  "name": "VEILLIA - recommandation instantanee Telegram",
  "nodes": [
    {
      "parameters": {
        "allowedUpdates": "message"
      },
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Message recu",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-620, 0],
      "webhookId": "veillia-telegram-message"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "telegram-commande",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/reco",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Commande /reco",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-380, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.VEILLIA_URL }}/api/recommandations/instantanees/?destinataire={{ $json.message.chat.id }}&nombre=3",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.VEILLIA_JETON }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Demander les recommandations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, -120]
    },
    {
      "parameters": {
        "jsCode": "// Met en forme la reponse pour Telegram\nconst corps = $input.first().json;\nconst reco = corps.recommandations ?? [];\n\nif (reco.length === 0) {\n  return [{ texte: 'Aucun article ne correspond a vos centres d interet pour le moment.' }];\n}\n\nconst liste = reco\n  .map((item, index) => {\n    const numero = index + 1;\n    const article = item.article;\n    const raison = item.raison ? ` (${item.raison})` : '';\n    return `${numero}. ${article.titre}${raison}\\n${article.resume.slice(0, 140)}\\n${article.lien}`;\n  })\n  .join('\\n\\n');\n\nreturn [{ texte: `Voici vos recommendations du moment :\\n\\n${liste}` }];"
      },
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Mettre en forme",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, -120]
    },
    {
      "parameters": {
        "chatId": "={{ $('Message recu').item.json.message.chat.id }}",
        "text": "={{ $json.texte }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": false
        }
      },
      "id": "c1000000-0000-4000-8000-000000000005",
      "name": "Repondre au membre",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [420, -120]
    },
    {
      "parameters": {},
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Ignorer les autres messages",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [-100, 160],
      "notes": "Les messages qui ne commencent pas par /reco sont ignores"
    }
  ],
  "connections": {
    "Message recu": {
      "main": [[{ "node": "Commande /reco", "type": "main", "index": 0 }]]
    },
    "Commande /reco": {
      "main": [
        [{ "node": "Demander les recommandations", "type": "main", "index": 0 }],
        [{ "node": "Ignorer les autres messages", "type": "main", "index": 0 }]
      ]
    },
    "Demander les recommandations": {
      "main": [[{ "node": "Mettre en forme", "type": "main", "index": 0 }]]
    },
    "Mettre en forme": {
      "main": [[{ "node": "Repondre au membre", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "d3000000-0000-4000-8000-000000000001",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}