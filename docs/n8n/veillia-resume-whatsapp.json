{
  "name": "VEILLIA - resume quotidien Whatsapp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 30 * *"
            }
          ]
        }
      },
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "Chaque matin a 7h30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-620, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.VEILLIA_URL }}/api/resumes/?etat=en_attente",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.VEILLIA_JETON }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "e1000000-0000-4000-8000-000000000002",
      "name": "Lire les resumes en attente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 0]
    },
    {
      "parameters": {
        "jsCode": "// Ne garde que les resumes WhatsApp et met le message en texte simple\nconst corps = $input.first().json.body ?? $input.first().json;\nconst lignes = corps.results ?? corps;\n\nconst messages = lignes\n  .filter((l) => l.canal === 'whatsapp')\n  .map((l) => {\n    const ligne = l;\n    const liste = (ligne.articles_detail ?? [])\n      .map((article, index) => {\n        const numero = index + 1;\n        return `${numero}. ${article.titre}\\n${article.resume.slice(0, 140)}\\n${article.lien}`;\n      })\n      .join('\\n\\n');\n\n    return {\n      resume_id: ligne.id,\n      destinataire: ligne.destinataire,\n      texte: `Bonjour ${ligne.pseudo_utilisateur}, votre veille data et IA du ${ligne.jour} :\\n\\n${liste}`\n    };\n  });\n\nreturn messages;"
      },
      "id": "e1000000-0000-4000-8000-000000000003",
      "name": "Construire les messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000004",
      "name": "Envoyer par lots de 10",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [140, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_NUMERO_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_JETON }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $json.destinataire, type: 'text', text: { preview_url: true, body: $json.texte } }) }}",
        "options": {
          "onError": "continueRegularOutput",
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000
        }
      },
      "id": "e1000000-0000-4000-8000-000000000005",
      "name": "Envoyer par l API Whatsapp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, -120]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "e1000000-0000-4000-8000-000000000006",
      "name": "Attendre 2 secondes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [680, -120]
    },
    {
      "parameters": {
        "url": "={{ $env.VEILLIA_URL }}/api/resumes/{{ $json.resume_id }}/statut/",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.VEILLIA_JETON }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ etat: 'envoye', erreur: '' }) }}",
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000007",
      "name": "Marquer comme envoye",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, -120]
    }
  ],
